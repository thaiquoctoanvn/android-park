<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- below android 12 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- android 12 and above -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- discovery needs location; FINE also requires COARSE -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- needed to read the MAC address -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- required="false": this is one sample among many, and required="true"
         filtered the whole app off Bluetooth-less devices on Play. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <application>
        <activity
            android:name=".BluetoothConnectingActivity"
            android:exported="false" />
        <activity
            android:name=".FileTransferActivity"
            android:exported="false" />
    </application>
</manifest>
